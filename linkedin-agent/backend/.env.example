# Which LLM provider client.py talks to: anthropic | openrouter | openai
# Switch this (and the matching key below) if one provider's account runs
# out of credits or is unreachable -- no code changes needed.
LLM_PROVIDER=anthropic

# --- anthropic (default) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- openrouter (set LLM_PROVIDER=openrouter to use this) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# --- openai (set LLM_PROVIDER=openai to use this) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: override the models used (defaults are picked automatically
# based on LLM_PROVIDER above -- see linkedin_agent/config.py)
# LINKEDIN_AGENT_MODEL=claude-sonnet-5
# LINKEDIN_AGENT_ROUTER_MODEL=claude-haiku-4-5-20251001

# Optional: where JSON state / markdown reports get written
LINKEDIN_AGENT_DATA_DIR=./data
LINKEDIN_AGENT_OUTPUT_DIR=./outputs

# Optional: days of silence before a pipeline entry is shown as "Ghosted"
LINKEDIN_AGENT_STALE_DAYS=21

# Optional: comma-separated list of frontend origins allowed to call this API
LINKEDIN_AGENT_CORS_ORIGINS=http://localhost:5173

# Optional: DEBUG for verbose logs (including third-party HTTP clients)
LINKEDIN_AGENT_LOG_LEVEL=INFO
