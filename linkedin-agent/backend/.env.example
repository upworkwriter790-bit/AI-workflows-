# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the models used
LINKEDIN_AGENT_MODEL=claude-sonnet-5
LINKEDIN_AGENT_ROUTER_MODEL=claude-haiku-4-5-20251001

# Optional: where JSON state / markdown reports get written
LINKEDIN_AGENT_DATA_DIR=./data
LINKEDIN_AGENT_OUTPUT_DIR=./outputs

# Optional: days of silence before a pipeline entry is shown as "Ghosted"
LINKEDIN_AGENT_STALE_DAYS=21

# Optional: comma-separated list of frontend origins allowed to call this API
LINKEDIN_AGENT_CORS_ORIGINS=http://localhost:5173

# Optional: DEBUG for verbose logs (including third-party HTTP clients)
LINKEDIN_AGENT_LOG_LEVEL=INFO
