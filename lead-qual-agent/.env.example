# Copy to .env and adjust. The agent runs with these defaults out of the box.

# ---- LLM backend selection ----
# Priority: USE_STUB_LLM > (USE_CLOUD_LLM + OPENAI_API_KEY) > Ollama
# Stub mode needs NO model server and makes the whole pipeline testable immediately.
USE_STUB_LLM=true
USE_CLOUD_LLM=false

# ---- Ollama (local dev) ----
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# ---- Cloud fallback (optional) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Storage ----
DB_PATH=./data/app.db
CHROMA_PERSIST_DIR=./data/chroma
CRM_DIR=./data/crm

# ---- RAG ----
RAG_ENABLED=true
