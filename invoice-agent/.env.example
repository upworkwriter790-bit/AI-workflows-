# ============================================================================
# invoice-agent — environment configuration
#
# Copy to .env and fill in real values before switching ENVIRONMENT to
# "production". In "development" (the default) every integration not given
# real credentials below runs against its MOCK adapter — nothing fake is
# ever sent to a real CRM, ERP, inbox, or product-access system.
# ============================================================================

ENVIRONMENT=development          # development | production
APP_SECRET_KEY=change-me-dev-only

# ---------------------------------------------------------------------------
# Company / tax identity — REQUIRED before production. No defaults: a
# missing value here blocks invoice generation rather than inventing one.
# ---------------------------------------------------------------------------
COMPANY_LEGAL_NAME=
COMPANY_REGISTERED_ADDRESS=
SELLER_GSTIN=
SELLER_STATE_NAME=
SELLER_STATE_CODE=
INVOICE_PREFIX=INV
# Python format string; {fy_start}/{fy_end} = 2-digit financial-year bounds,
# {seq} = zero-padded sequence number, {seq_width} controls padding.
INVOICE_NUMBER_FORMAT=INV/FY{fy_start}-{fy_end}/{seq:06d}
SUPPORT_EMAIL=
SUPPORT_PHONE=
INVOICE_LOGO_PATH=

# ---------------------------------------------------------------------------
# Database / queue
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://invoice_agent:invoice_agent@localhost:5432/invoice_agent
# Local dev without a running Postgres: use sqlite instead, e.g.
# DATABASE_URL=sqlite:///./invoice_agent.db
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# CRM integration
# ---------------------------------------------------------------------------
CRM_PROVIDER=mock                # mock | <real adapter name once implemented>
CRM_NAME=
CRM_API_BASE_URL=
CRM_API_KEY=
CRM_WEBHOOK_HMAC_SECRET=change-me-dev-only

# ---------------------------------------------------------------------------
# ERP integration
# ---------------------------------------------------------------------------
ERP_PROVIDER=mock
ERP_NAME=
ERP_API_BASE_URL=
ERP_API_KEY=

# ---------------------------------------------------------------------------
# Product access system
# ---------------------------------------------------------------------------
PRODUCT_ACCESS_PROVIDER=mock
PRODUCT_ACCESS_SYSTEM_NAME=
PRODUCT_ACCESS_API_BASE_URL=
PRODUCT_ACCESS_API_KEY=

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=mock              # mock | ses | resend | sendgrid
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=

# ---------------------------------------------------------------------------
# Operations notification
# ---------------------------------------------------------------------------
OPERATIONS_NOTIFICATION_PROVIDER=mock   # mock | slack | teams | email | crm_task
OPERATIONS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local           # local | s3 | r2 | azure_blob
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_LOCAL_DIR=./storage_dev

# ---------------------------------------------------------------------------
# LLM — multi-provider. Pick one provider via LLM_PROVIDER; only its key is
# required. The system prompt + JSON schema are identical across providers.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic           # anthropic | openai | openrouter | gemini | sarvam
LLM_MODEL=                       # optional override; sane default per provider if blank

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=

# ---------------------------------------------------------------------------
# Decision thresholds (Use Case 2)
# ---------------------------------------------------------------------------
AUTO_ACCEPT_MAX_AMOUNT=0          # 0 = nothing auto-accepts until you set a real ceiling
CRITICAL_FIELD_CONFIDENCE_THRESHOLD=0.95
TAX_MISMATCH_TOLERANCE=0.01

# ---------------------------------------------------------------------------
# Monitoring
# ---------------------------------------------------------------------------
SENTRY_DSN=
