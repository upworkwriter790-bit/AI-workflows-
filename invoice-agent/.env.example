# ============================================================================
# invoice-agent — Invoice Delivery Agent environment configuration
#
# Copy to .env and fill in real values before switching APP_ENV to
# "production". With no provider credentials set, EMAIL_PROVIDER and
# WHATSAPP_PROVIDER default to "mock" — nothing is ever sent to a real
# inbox or phone number until you configure a real provider.
# ============================================================================

APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./invoice_agent.db
# Local dev without a running Postgres: the sqlite default above works.
# Production: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/invoice_agent
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-dev-only

STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

MAX_FILE_SIZE_MB=10
SECURE_LINK_EXPIRY_DAYS=7
SECURE_LINK_MAX_DOWNLOADS=3

EMAIL_PROVIDER=mock
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
EMAIL_API_KEY=
EMAIL_WEBHOOK_SIGNING_SECRET=

WHATSAPP_PROVIDER=mock
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=
WHATSAPP_TEMPLATE_ID=
WHATSAPP_WEBHOOK_SIGNING_SECRET=

RETRY_MAX_ATTEMPTS=4
RETRY_SCHEDULE_MINUTES=1,5,30,120

# ----------------------------------------------------------------------------
# Invoice generation (Method B — payment-details-to-invoice) additions.
# Method A (existing-PDF delivery) does not need any of these; it only
# needs the variables above. generated_invoices_ready on GET /health is
# false until the five identity fields below are all set — Method B
# refuses to generate an invoice with invented or blank seller details.
# ----------------------------------------------------------------------------

# Invoice generation identity
COMPANY_LEGAL_NAME=
COMPANY_REGISTERED_ADDRESS=
SELLER_GSTIN=
SELLER_STATE_NAME=
SELLER_STATE_CODE=
SUPPORT_EMAIL=
SUPPORT_PHONE=
COMPANY_LOGO_URL=

# Invoice numbering
INVOICE_PREFIX=INV
INVOICE_NUMBER_FORMAT={prefix}/FY{fy_start_short}-{fy_end_short}/{sequence}
INVOICE_SEQUENCE_PADDING=6
FINANCIAL_YEAR_START_MONTH=4

# Invoice PDF
INVOICE_TEMPLATE_VERSION=v1
# Only "weasyprint" is implemented; "playwright" is accepted as a config
# value (per the spec's suggested default) but not yet built.
PDF_RENDERER=weasyprint
PDF_TIMEZONE=Asia/Kolkata

# Tax rules
TAX_TOLERANCE_AMOUNT=0.01
CURRENCY=INR
ROUNDING_MODE=HALF_UP
REVERSE_CHARGE_APPLICABLE=false

# Retention
DOCUMENT_RETENTION_DAYS=90
