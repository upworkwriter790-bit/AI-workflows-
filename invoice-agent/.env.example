# ============================================================================
# invoice-agent — Invoice Delivery Agent environment configuration
#
# Copy to .env and fill in real values before switching APP_ENV to
# "production". With no provider credentials set, EMAIL_PROVIDER and
# WHATSAPP_PROVIDER default to "mock" — nothing is ever sent to a real
# inbox or phone number until you configure a real provider.
# ============================================================================

APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./invoice_agent.db
# Local dev without a running Postgres: the sqlite default above works.
# Production: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/invoice_agent
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-dev-only

STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

MAX_FILE_SIZE_MB=10
SECURE_LINK_EXPIRY_DAYS=7
SECURE_LINK_MAX_DOWNLOADS=3

EMAIL_PROVIDER=mock
EMAIL_FROM_NAME=
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO_ADDRESS=
EMAIL_API_KEY=
EMAIL_WEBHOOK_SIGNING_SECRET=

WHATSAPP_PROVIDER=mock
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=
WHATSAPP_TEMPLATE_ID=
WHATSAPP_WEBHOOK_SIGNING_SECRET=

RETRY_MAX_ATTEMPTS=4
RETRY_SCHEDULE_MINUTES=1,5,30,120

COMPANY_LEGAL_NAME=
SUPPORT_EMAIL=
