# ============================================================================
# WhatsApp Booking CRM — environment template
# ----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. NEVER commit secrets.
# The app runs fully in "simulator / demo" mode with NONE of these set — every
# integration degrades gracefully so you can test the booking flow locally.
# ============================================================================

# --- Meta WhatsApp Cloud API (official Business API) ------------------------
# From Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
# Any string you choose; you enter the SAME value in Meta webhook config.
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
# Meta App Dashboard → App Settings → Basic → App Secret (verifies webhook HMAC)
META_APP_SECRET=your-meta-app-secret
WHATSAPP_API_VERSION=v21.0

# --- AI auto-reply (fallback chain: Gemini -> Gemini 2.0 -> OpenAI) ---------
# At least one recommended. With none set, the deterministic engine handles
# everything (no LLM "wrapper", but bookings still complete).
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: route OpenAI-compatible calls through OpenRouter instead.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Appointment sync (Google Apps Script web app -> Sheets + Calendar) -----
# Deploy the script in /scripts/google-apps-script.gs and paste its /exec URL.
GOOGLE_SHEETS_WEBHOOK_URL=
# Shared secret echoed by the Apps Script so only you can POST to it.
GOOGLE_SHEETS_WEBHOOK_SECRET=

# --- Encryption (AES-256-GCM at rest, e.g. stored WhatsApp tokens) ----------
# Generate a NEW one — do not reuse any example value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=generate-a-fresh-32-byte-hex-key

# --- Reminders / cron auth --------------------------------------------------
# Protects /api/cron/reminders so only your scheduler can trigger it.
CRON_SECRET=pick-any-long-random-string

# --- Admin login ------------------------------------------------------------
# Set this to require a login for the CRM (Builder, Inbox, Dashboard, Settings).
# Leave EMPTY for open/demo mode (no login).
ADMIN_PASSWORD=

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=WhatsApp Booking CRM
